[Unit]
Description=sysc-notify notification daemon
Documentation=https://github.com/Nomadcxx/sysc-notify

# Claim the notifications name on the session bus. Type=dbus makes systemd
# consider the unit started once org.freedesktop.Notifications is owned, so a
# requester that raced the daemon can be told to retry instead of failing.
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target

# A notification daemon that cannot stay up should stop trying and leave the
# session usable rather than respawn forever.
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=%h/.local/bin/sysc-notify
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
