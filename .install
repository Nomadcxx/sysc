#!/bin/sh
# SYSC source installer. Builds the installer from source and runs it.
# Usage: curl -fsSL https://raw.githubusercontent.com/Nomadcxx/sysc/main/.install | sh
#
# The body is a function called on the last line so a piped script
# (curl | sh) is parsed completely before it runs. Bash, including
# bash --posix as /bin/sh, reads that pipe incrementally; replacing the
# shell's own stdin would make the rest of this file come from the
# terminal, and a failed redirect of a special builtin would exit before
# --yes. Only the installer process is attached to /dev/tty.
set -eu

main() {
  command -v go >/dev/null 2>&1 || { echo "Go is required: https://go.dev/doc/install" >&2; exit 1; }
  command -v git >/dev/null 2>&1 || { echo "git is required" >&2; exit 1; }

  TMP=$(mktemp -d)
  git clone --depth 1 https://github.com/Nomadcxx/sysc.git "$TMP/sysc"
  (cd "$TMP/sysc" && go build -o "$TMP/sysc-bin" ./cmd/sysc)

  set +e
  if have_tty; then
    "$TMP/sysc-bin" "$@" </dev/tty
  else
    "$TMP/sysc-bin" --yes "$@"
  fi
  status=$?
  set -e

  rm -rf "$TMP"
  exit "$status"
}

# have_tty is true when a controlling terminal can be opened. The probe
# is a subshell so a failed redirection of ":" cannot abort this shell.
have_tty() {
  ( : </dev/tty ) >/dev/null 2>&1
}

main "$@"
